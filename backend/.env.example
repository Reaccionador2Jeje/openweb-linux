# Bind to localhost behind a TLS reverse proxy in production.
HOST=127.0.0.1
PORT=8787

# Generate with: openssl rand -hex 32
OPENWEB_ACCESS_TOKEN=replace-with-a-long-random-secret

# Primary hosted runtime: Docker creates one restricted container per terminal session.
# For local Android Termux + Ubuntu PRoot development, use OPENWEB_RUNTIME=proot.
OPENWEB_RUNTIME=docker
OPENWEB_DOCKER_IMAGE=ubuntu:24.04
OPENWEB_DOCKER_SHELL=/bin/bash
OPENWEB_PROOT_SHELL=/bin/bash
# Configure DOCKER_HOST only for a trusted, authenticated remote Docker Engine.
# Access to a Docker socket/API is effectively host-administrator access.

# Optional local runtime: OPENWEB_RUNTIME=proot (binds localhost; no isolation).
# Optional experimental runtime (OPENWEB_RUNTIME=nelroot).
NELROOT_BIN=nelroot
NELROOT_IMAGE=ubuntu
NELROOT_SHELL=/bin/bash

# Comma-separated exact browser origins. Empty means same-origin/no Origin only.
OPENWEB_ALLOWED_ORIGINS=https://your-site.example

# Session limits
OPENWEB_MAX_SESSIONS=3
OPENWEB_IDLE_TIMEOUT_MS=1800000
OPENWEB_MAX_INPUT_BYTES=16384

# Enable token-based sessions from the local-device UI (?mode=local).
# Keep false on public/hosted deployments unless you explicitly need local access.
OPENWEB_ENABLE_LOCAL_AUTH=false

# GitHub OAuth App (create one in GitHub Developer Settings).
OPENWEB_GITHUB_CLIENT_ID=
OPENWEB_GITHUB_CLIENT_SECRET=
OPENWEB_BACKEND_PUBLIC_URL=https://your-backend.example
OPENWEB_FRONTEND_URL=https://your-site.example/
# Comma-separated approved GitHub usernames. Empty means nobody can sign in.
OPENWEB_GITHUB_ALLOWED_USERS=
